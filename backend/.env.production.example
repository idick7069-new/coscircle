PORT=8080
NODE_ENV=production
CORS_ORIGINS=https://your-admin.example.com,https://your-web.example.com
PUBLIC_APP_URL=https://your-web.example.com/app

# Keep disabled until domain verification and a real delivery test succeed.
MAIL_ENABLED=false
MAIL_PROVIDER=resend
MAIL_FROM="CosCircle <no-reply@coscircle.app>"
RESEND_API_KEY=

MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=coscircle_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=coscircle

EVENT_SCRAPER_ENABLED=true
EVENT_SCRAPER_TIME_ZONE=Asia/Taipei
EVENT_SCRAPER_PYTHON=/opt/coscircle/api/current/.crawler-venv/bin/python
# Used by the Mac edge collector endpoint POST /api/source-ingest/doujin-html.
# Generate a long random value and store the same value on the collector host.
SYNC_INGEST_TOKEN=replace-with-a-long-random-token

FIREBASE_PROJECT_ID=coscircle
# Store this in Secret Manager or the host secret store. Do not commit it.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Public LINE Login channel ID, not a channel secret.
LINE_LOGIN_CHANNEL_ID=2011925571
