  # BEGIN PUBLIC LEGAL PAGES
  # Never return the landing-page fallback for these Play review resources.
  location = /child-safety.html {
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
  }
  location = /privacy.html {
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
  }
  location = /terms.html {
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
  }
  location = /delete-account.html {
    try_files $uri =404;
    add_header Cache-Control "no-store" always;
  }
  location = /delete-account.js {
    try_files $uri =404;
    add_header Cache-Control "no-store" always;
  }
  location = /legal.css {
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
  }
  # END PUBLIC LEGAL PAGES
