NODE_ENV=production
PORT=8080
CORS_ORIGINS=https://coscircle.xxx,https://admin.coscircle.xxx
PUBLIC_APP_URL=https://coscircle.app/app

# Store the real key only in the restricted VM environment file.
MAIL_ENABLED=false
MAIL_PROVIDER=resend
MAIL_FROM="CosCircle <no-reply@coscircle.app>"
RESEND_API_KEY=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=coscircle_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=coscircle

EVENT_SCRAPER_ENABLED=true
EVENT_SCRAPER_TIME_ZONE=Asia/Taipei
# Public LINE Login channel ID, not a channel secret.
LINE_LOGIN_CHANNEL_ID=2011925571
