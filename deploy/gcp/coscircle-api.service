[Unit]
Description=CosCircle API
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=coscircle
Group=coscircle
WorkingDirectory=/opt/coscircle/api/current
EnvironmentFile=/etc/coscircle/api.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/coscircle/api /var/lib/coscircle/uploads

[Install]
WantedBy=multi-user.target
